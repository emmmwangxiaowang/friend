class CommunityDetailScreen extends StatelessWidget {
  final String id;
  const CommunityDetailScreen({Key? key, required this.id}) : super(key: key);
  @override
  Widget build(BuildContext context) =>
      Center(child: Text('Community Detail: $id'));
}

// Shell widget with persistent bottom navigation
class ScaffoldWithNavBar extends StatelessWidget {
  final Widget child;
  final int currentIndex;

  const ScaffoldWithNavBar({
    Key? key,
    required this.child,
    required this.currentIndex,
  }) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: child,
      bottomNavigationBar: BottomNavBar(
        currentIndex: currentIndex,
        onTap: (index) {
          switch (index) {
            case 0:
              context.go('/');
              break;
            case 1:
              context.go('/discover');
              break;
            case 2:
              context.go('/community');
              break;
          }
        },
      ),
    );
  }
}

// Router configuration
final GoRouter router = GoRouter(
  initialLocation: '/',
  routes: [
    // Shell route for bottom navigation tabs
    ShellRoute(
      builder: (context, state, child) {
        // Determine current tab index from location
        final location = state.uri.path;
        int currentIndex = 0;
        if (location.startsWith('/discover')) {
          currentIndex = 1;
        } else if (location.startsWith('/community')) {
          currentIndex = 2;
        }
        return ScaffoldWithNavBar(
          currentIndex: currentIndex,
          child: child,
        );
      },
      routes: [
        // Home tab
        GoRoute(
          path: '/',
          pageBuilder: (context, state) => const NoTransitionPage(
            child: HomeScreen(),
          ),
        ),
        // Discover tab
        GoRoute(
          path: '/discover',
          pageBuilder: (context, state) => const NoTransitionPage(
            child: DiscoverScreen(),
          ),
        ),
        // Community tab with nested detail route
        GoRoute(
          path: '/community',
          pageBuilder: (context, state) => const NoTransitionPage(
            child: CommunityScreen(),
          ),
          routes: [
            GoRoute(
              path: ':id',
              builder: (context, state) {
                final id = state.pathParameters['id']!;
                return CommunityDetailScreen(id: id);
              },
            ),
          ],
        ),
      ],
    ),
    // Chat routes (outside shell - no bottom nav)
    GoRoute(
      path: '/chat',
      builder: (context, state) => const ChatListScreen(),
      routes: [
        GoRoute(
          path: ':id',
          builder: (context, state) {
            final id = state.pathParameters['id']!;
            return ChatDetailScreen(id: id);
          },
        ),
      ],
    ),
    // Profile routes
    GoRoute(
      path: '/profile',
      builder: (context, state) => const ProfileScreen(),
      routes: [
        GoRoute(
          path: ':id',
          builder: (context, state) {
            final id = state.pathParameters['id']!;
            return ProfileScreen(id: id);
          },
        ),
      ],
    ),
    // Groups routes
    GoRoute(
      path: '/groups',
      builder: (context, state) => const GroupsScreen(),
      routes: [
        GoRoute(
          path: ':id',
          builder: (context, state) {
            final id = state.pathParameters['id']!;
            return GroupsScreen(id: id);
          },
        ),
      ],
    ),
    // Soul test routes
    GoRoute(
      path: '/soul-test',
      builder: (context, state) => const SoulTestScreen(),
      routes: [
        GoRoute(
          path: ':id',
          builder: (context, state) {
            final id = state.pathParameters['id']!;
            return SoulTestScreen(id: id);
          },
        ),
      ],
    ),
  ],
);
