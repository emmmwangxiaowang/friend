  final String? id;
  const GroupsScreen({Key? key, this.id}) : super(key: key);
  @override
  Widget build(BuildContext context) =>
      Center(child: Text('Groups${id != null ? ': $id' : ''}'));
}

class SoulTestScreen extends StatelessWidget {
  final String? id;
  const SoulTestScreen({Key? key, this.id}) : super(key: key);
  @override
  Widget build(BuildContext context) =>
      Center(child: Text('Soul Test${id != null ? ': $id' : ''}'));
