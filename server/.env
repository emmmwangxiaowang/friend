# SoulMate 环境配置 (服务端)

# 数据库 - PostgreSQL
# 使用用户提供的配置
DATABASE_URL="postgresql://postgres:123456@localhost:5432/postgres?schema=public"

# Redis - 使用现有的 redis (端口 6379)
REDIS_URL="redis://localhost:6379"

# JWT 密钥
JWT_ACCESS_SECRET="soulmate-access-secret-change-in-production"
JWT_REFRESH_SECRET="soulmate-refresh-secret-change-in-production"

# AI 配置 (可选)
# OPENAI_API_KEY="sk-your-openai-api-key"
